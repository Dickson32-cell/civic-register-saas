// CivicData — multi-tenant register platform schema
// Derived from the proven 8-council register engine; council_id -> tenant_id
// (tenant_id has NO default anywhere: every write states its tenant explicitly —
// the RLS "silent adweso default" bug class can never reproduce here).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// CONTROL PLANE
// ---------------------------------------------------------------------------

// One row per institution on the platform
model Tenant {
  id          String   @id @db.VarChar(24) // slug, e.g. "adweso", "bethel-chapel"
  name        String   @db.VarChar(150)
  template    String   @default("FEE_REGISTER") @db.VarChar(20) // FEE_REGISTER | MEMBERS_DUES
  colour      String   @default("#0a3b2a") @db.VarChar(16)
  logoUrl     String?  @map("logo_url") @db.VarChar(300)
  areas       Json     @default("[]") // [{ area: "Ada", code: "ADA" }]
  ownerEmail  String   @map("owner_email") @db.VarChar(120)
  ownerName   String   @map("owner_name") @db.VarChar(120)
  status      String   @default("TRIAL") @db.VarChar(12) // TRIAL | ACTIVE | SUSPENDED
  trialEndsAt DateTime @map("trial_ends_at") @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Freemium entitlements (free data collection; paid services unlocked by the system admin)
  staffSeatLimit   Int     @default(2) @map("staff_seat_limit")  // free plan staff cap
  brandingUnlocked Boolean @default(false) @map("branding_unlocked") // logo upload = paid service
  logoDataUrl      String? @map("logo_data_url")                     // institution logo (unlocked only)
  billHeadingOverride String? @map("bill_heading_override") @db.VarChar(120) // bill designer (locked)
  billFooterNote      String? @map("bill_footer_note") @db.VarChar(200)      // bill designer (locked)
  billTitle       String? @map("bill_title") @db.VarChar(60)   // e.g. "TEMPORAL STRUCTURES BILL" (locked)
  billLegal1      String? @map("bill_legal1") @db.VarChar(700) // first legal paragraph (locked)
  billLegal2      String? @map("bill_legal2") @db.VarChar(700) // second legal paragraph (locked)
  billStampCaption String? @map("bill_stamp_caption") @db.VarChar(40) // e.g. "ZONAL COUNCIL STAMP" (locked)

  subscription Subscription?

  serviceRequests ServiceRequest[]

  @@map("tenant")
}

// A paid-service request from an institution (approved by the system admin / master console)
model ServiceRequest {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.VarChar(24)
  kind         String    @db.VarChar(20)  // STAFF_SEATS | BRANDING
  seats        Int?      // requested staff seats (STAFF_SEATS)
  note         String?   @db.VarChar(300)
  contactPhone String?   @map("contact_phone") @db.VarChar(20)
  assetDataUrl String?   @map("asset_data_url") // logo attached with the request
  status       String    @default("PENDING") @db.VarChar(10) // PENDING | APPROVED | REJECTED
  decidedBy    String?   @map("decided_by") @db.VarChar(120)
  decidedNote  String?   @map("decided_note") @db.VarChar(300)
  decidedAt    DateTime? @map("decided_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([status])
  @@map("service_request")
}

// The institution's subscription (one active row per tenant in v1)
model Subscription {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @unique @map("tenant_id") @db.VarChar(24)
  plan      String   @default("ANNUAL") @db.VarChar(12) // ANNUAL
  priceGhs  Decimal  @default(4000) @map("price_ghs") @db.Decimal(12, 2)
  status    String   @default("TRIAL") @db.VarChar(12) // TRIAL | ACTIVE | PAST_DUE | CANCELLED
  startedAt DateTime @default(now()) @map("started_at") @db.Timestamptz(3)
  renewsAt  DateTime? @map("renews_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("subscription")
}

// Platform-level payments (Paystack — invoices the INSTITUTION, never custody)
model PlatformPayment {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.VarChar(24)
  reference String   @unique @db.VarChar(60)
  amountGhs Decimal  @map("amount_ghs") @db.Decimal(12, 2)
  currency  String   @default("GHS") @db.VarChar(6)
  provider  String   @default("PAYSTACK") @db.VarChar(12)
  status    String   @default("PENDING") @db.VarChar(10) // PENDING | SUCCESS | FAILED
  paidAt    DateTime? @map("paid_at") @db.Timestamptz(3)
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("platform_payment")
}

// ---------------------------------------------------------------------------
// TENANT PLANE — the proven register engine, one tenant per row group
// ---------------------------------------------------------------------------

// The register — one row per registered person / property / item
model FeePayer {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.VarChar(24)
  createdBy     String?  @map("created_by") @db.Uuid
  createdByUser AppUser? @relation("FeePayerCreator", fields: [createdBy], references: [id])
  serialNumber  String   @map("serial_number") @db.VarChar(20)
  electoralArea String   @map("electoral_area") @db.VarChar(40)
  name          String   @db.VarChar(120)
  businessName  String   @map("business_name") @db.VarChar(150)
  telephone     String   @db.VarChar(10)
  streetName    String   @map("street_name") @db.VarChar(150)
  latitude      Decimal? @db.Decimal(10, 7)
  longitude     Decimal? @db.Decimal(10, 7)
  businessType  String?  @map("business_type") @db.VarChar(80)
  containerSize String?  @map("container_size") @db.VarChar(24)
  containerCategory String? @map("container_category") @db.VarChar(12)
  bopFee        Decimal? @map("bop_fee") @db.Decimal(12, 2)
  pendingId     String?  @map("pending_id") @db.VarChar(64)
  fee           Decimal  @db.Decimal(12, 2)
  status        String   @default("UNPAID") @db.VarChar(10) // UNPAID | PAID
  recordStatus  String   @default("ACTIVE") @map("record_status") @db.VarChar(10) // ACTIVE | INACTIVE
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  fees     Fee[]
  payments Payment[]
  pendingEdits PendingEdit[]

  @@unique([tenantId, serialNumber])
  @@index([tenantId, recordStatus])
  @@map("fee_payer")
}

// Billing events (supports cumulative Total)
model Fee {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.VarChar(24)
  feePayerId  String   @map("fee_payer_id") @db.Uuid
  amount      Decimal  @db.Decimal(12, 2)
  description String   @default("Registration fee") @db.VarChar(200)
  billedAt    DateTime @default(now()) @map("billed_at") @db.Timestamptz(3)
  createdBy   String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  feePayer FeePayer @relation(fields: [feePayerId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("fee")
}

// Cash received — the record's payment ledger (NOT platform custody;
// amounts the staff collected in person, recorded as evidence)
model Payment {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.VarChar(24)
  feePayerId  String   @map("fee_payer_id") @db.Uuid
  amount      Decimal  @db.Decimal(12, 2)
  method      String   @default("CASH") @db.VarChar(10)
  receiptNo   String?  @map("receipt_no") @db.VarChar(30)
  receivedAt  DateTime @default(now()) @map("received_at") @db.Timestamptz(3)
  receivedBy  String?  @map("received_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  feePayer FeePayer @relation(fields: [feePayerId], references: [id], onDelete: Cascade)
  receivedByUser AppUser? @relation("PaymentReceivedBy", fields: [receivedBy], references: [id])

  @@index([tenantId])
  @@map("payment")
}

// One row per tenant electoral area — the serial sequence (transactional safety)
model SerialCounter {
  tenantId      String @map("tenant_id") @db.VarChar(24)
  electoralArea String @map("electoral_area") @db.VarChar(40)
  lastNumber    Int    @default(0) @map("last_number")

  @@id([tenantId, electoralArea])
  @@map("serial_counter")
}

// Staff logins (username unique per tenant)
model AppUser {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.VarChar(24)
  username     String   @db.VarChar(50)
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name") @db.VarChar(120)
  role         String   @default("STAFF") @db.VarChar(10) // ADMIN | STAFF
  adminLevel   String?  @map("admin_level") @db.VarChar(10) // FULL | EDITOR | VIEWER
  viewerAreas  String[] @default([]) @map("viewer_areas")
  active       Boolean  @default(true)
  approvedAt   DateTime? @map("approved_at") // NULL = registered, not yet approved
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  passwordRequests PasswordChangeRequest[]
  paymentsReceived Payment[] @relation("PaymentReceivedBy")
  feePayersCreated FeePayer[] @relation("FeePayerCreator")

  @@unique([tenantId, username])
  @@map("app_user")
}

// Password change requests — applied only after admin approval
model PasswordChangeRequest {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.VarChar(24)
  userId      String    @map("user_id") @db.Uuid
  newHash     String    @map("new_hash")
  status      String    @default("PENDING") @db.VarChar(10) // PENDING | APPROVED | REJECTED
  requestedAt DateTime  @default(now()) @map("requested_at") @db.Timestamptz(3)
  reviewedBy  String?   @map("reviewed_by") @db.Uuid
  reviewedAt  DateTime? @map("reviewed_at") @db.Timestamptz(3)

  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_change_request")
}

// Staff edit requests — identity-field changes awaiting admin approval
model PendingEdit {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.VarChar(24)
  feePayerId  String    @map("fee_payer_id") @db.Uuid
  before      Json
  after       Json
  status      String    @default("PENDING") @db.VarChar(10) // PENDING | APPROVED | REJECTED
  requestedBy String    @map("requested_by") @db.Uuid
  reviewedBy  String?   @map("reviewed_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  reviewedAt  DateTime? @map("reviewed_at") @db.Timestamptz(3)

  feePayer FeePayer @relation(fields: [feePayerId], references: [id], onDelete: Cascade)

  @@map("pending_edit")
}

// Immutable audit trail
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  tenantId   String   @map("tenant_id") @db.VarChar(24)
  userId     String?  @map("user_id") @db.Uuid
  action     String   @db.VarChar(30)
  entityType String   @map("entity_type") @db.VarChar(20)
  entityId   String?  @map("entity_id") @db.Uuid
  details    Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([tenantId, createdAt])
  @@map("audit_log")
}

// Trial / licensing state (one row per tenant; created at signup)
model LicenseState {
  id            String    @id @db.VarChar(24) // = tenantId (platform: id column kept for engine parity)
  paidThrough   Int       @default(0) @map("paid_through")
  trialEndsAt   DateTime? @map("trial_ends_at") @db.Timestamptz(3)
  licenseKey    String?   @map("license_key") @db.VarChar(40)
  lastPaymentAt DateTime? @map("last_payment_at")
  pendingRef    String?   @map("pending_ref") @db.VarChar(60)
  pendingRefAt  DateTime? @map("pending_ref_at")

  @@map("license_state")
}

model SmsSend {
  id        String   @id @db.VarChar(64) // widened: fee_payer ids are 36-char UUIDs
  tenantId  String   @map("tenant_id") @db.VarChar(24)
  recordId  String   @map("record_id") @db.VarChar(64)
  type      String   @db.VarChar(16) // THANK_YOU | BILL_NOTICE
  phone     String   @db.VarChar(15)
  status    String   @default("SENT") @db.VarChar(10) // SENT | FAILED
  sentAt    DateTime @default(now()) @map("sent_at") @db.Timestamptz(3)

  @@unique([tenantId, recordId, type])
  @@map("sms_send")
}

// Offline outbox dedupe (partial unique index applied via SQL migration)
// pendingId on FeePayer carries the client UUID; unique per tenant.